{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_type": "Team",
      "actor_id": 19994465,
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    { "type": "required_signatures" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 2,
        "require_code_owner_review": true,
        "dismiss_stale_reviews_on_push": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Lint", "integration_id": 15368 },
          { "context": "Typecheck", "integration_id": 15368 },
          { "context": "Supply chain integrity", "integration_id": 15368 },
          { "context": "Build (Node 20.x)", "integration_id": 15368 },
          { "context": "Build (Node 22.x)", "integration_id": 15368 },
          { "context": "Dependency review", "integration_id": 15368 },
          { "context": "Conventional PR title", "integration_id": 15368 },
          { "context": "Analyze (actions)", "integration_id": 15368 },
          { "context": "Analyze (javascript-typescript)", "integration_id": 15368 }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          { "tool": "CodeQL", "security_alerts_threshold": "high_or_higher", "alerts_threshold": "errors" }
        ]
      }
    }
  ]
}
